<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppTeste.Views.CoinView"
             Title="CoinView">
    <VerticalStackLayout Padding="30,0"
                         Spacing="25">

        <Image x:Name="CoinImage"
               Source="logoJogo.png"
               WidthRequest="100" />       

        <Picker x:Name="HeadTailsPicker" SelectedItem="{Binding LadoEscolhido}"
                Title="Selecione cara ou coroa">
            <Picker.Items>
                <x:String>Cara</x:String>
                <x:String>Coroa</x:String>
            </Picker.Items>
        </Picker>

        <Button x:Name="CoinFlipButton"
                Command="{Binding FlipCommand}"
                Text="Girar a moeda" />

        <Label x:Name="ResultLabel"
        Text="{Binding Resultado}" />

        <Image x:Name="CoinResult"
       Source="{Binding Imagem}"
       WidthRequest="100" />

    </VerticalStackLayout>
</ContentPage>